PROJECT_NAME           = "LAR Packet Monitor"
PROJECT_NUMBER         = "1.0.0"
PROJECT_BRIEF          = "Mapped UDP capture, LAR/DLZ presentation, recording, and replay"

# Run this file from the repository root: doxygen Doxyfile
OUTPUT_DIRECTORY       = .
CREATE_SUBDIRS         = NO
OUTPUT_LANGUAGE        = English
FULL_PATH_NAMES        = YES
STRIP_FROM_PATH        = .

INPUT                  = src \
                         tools/map_asset \
                         ProjectSpecification.md \
                         docs/README.md \
                         docs/ARCHITECTURE.md \
                         docs/COMPONENT_REFERENCE.md \
                         docs/CONCURRENCY_MODEL.md \
                         docs/DATA_FLOWS.md \
                         docs/DLZ_MODEL.md \
                         docs/DEVELOPER_GUIDE.md \
                         docs/LAR1_FORMAT.md \
                         docs/PROTOCOL_UNITS.md \
                         docs/QUALITY_GATES.md \
                         docs/SOLID_COMPLIANCE.md \
                         docs/THREAT_MODEL.md
FILE_PATTERNS          = *.h *.hpp *.cpp *.md
RECURSIVE              = YES
EXCLUDE_PATTERNS       = */build-*/* */tests/* */html/* */latex/* \
                         */src/testsender/README.md
USE_MDFILE_AS_MAINPAGE = docs/README.md

EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = YES
EXTRACT_STATIC         = YES
EXTRACT_ANON_NSPACES   = YES
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO
HIDE_UNDOC_NAMESPACES  = NO
INHERIT_DOCS           = YES
BUILTIN_STL_SUPPORT    = YES
SORT_MEMBER_DOCS       = NO
SHOW_FILES             = YES
SHOW_NAMESPACES        = YES
SHOW_INCLUDE_FILES     = YES
SHOW_USED_FILES        = YES

JAVADOC_AUTOBRIEF      = YES
QT_AUTOBRIEF           = YES
MARKDOWN_SUPPORT       = YES
AUTOLINK_SUPPORT       = YES

GENERATE_HTML          = YES
HTML_OUTPUT            = html
GENERATE_TREEVIEW      = YES
DISABLE_INDEX          = NO
SEARCHENGINE           = YES
SERVER_BASED_SEARCH    = NO
SOURCE_BROWSER         = YES
INLINE_SOURCES         = YES
SOURCE_TOOLTIPS        = YES
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION    = YES
GENERATE_LATEX         = NO
GENERATE_XML           = NO

HAVE_DOT               = YES
COLLABORATION_GRAPH    = YES
GROUP_GRAPHS           = YES
INCLUDE_GRAPH          = YES
INCLUDED_BY_GRAPH      = YES
DIRECTORY_GRAPH        = YES
CALL_GRAPH             = YES
CALLER_GRAPH           = YES
DOT_IMAGE_FORMAT       = svg
INTERACTIVE_SVG        = YES
DOT_GRAPH_MAX_NODES    = 200
MAX_DOT_GRAPH_DEPTH    = 4

QUIET                  = NO
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = YES
WARN_AS_ERROR          = FAIL_ON_WARNINGS
WARN_LOGFILE           = doxygen-warnings.log

PREDEFINED             = Q_OBJECT= \
                         Q_GADGET= \
                         Q_ENUM(x)= \
                         Q_DECLARE_METATYPE(x)= \
                         signals=public \
                         slots= \
                         emit=
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = YES
