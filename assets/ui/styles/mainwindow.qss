QMainWindow, QWidget { background: #eef0ed; color: #27322d; }
QFrame#sidebar { background: #ffffff; }
QFrame#sidebar QWidget { background: #ffffff; }
QFrame#currentValuesColumn { background: #ffffff; border-left: 1px solid #cdd3cf; }
QLabel#brand { font-size: 18px; font-weight: 700; color: #193e35; }
QLabel#columnTitle { background: #ffffff; border-bottom: 1px solid #d6dbd8; font-weight: 600; }
QWidget#currentValuesContent { background: #ffffff; }
QStackedWidget#currentValuesStack { background: #ffffff; }
QScrollArea#hudValuesScroll { background: #ffffff; border: 0; }
QWidget#hudValuesContent { background: #ffffff; }
QLabel#entityHeader { background: #e7eeea; border-left: 3px solid #357461; color: #193e35; font-size: 13px; font-weight: 700; padding: 7px 8px; }
QLabel#valueGroupHeader { background: #f3f5f3; border-bottom: 1px solid #dce2de; color: #4f5f58; font-size: 11px; font-weight: 700; padding: 5px 6px; }
QLabel#valueName { background: #ffffff; color: #52605a; padding-left: 8px; }
QLabel#currentValue { background: #ffffff; color: #18251f; }
QFrame#entityDivider { background: #cbd3ce; border: 0; max-height: 1px; min-height: 1px; }
QFrame#telemetryIndicators { background: #ffffff; border-top: 1px solid #d6dbd8; }
QGroupBox#viewportControlRail { background: transparent; border: 0; margin: 0; padding: 0; }
QGroupBox#viewportControlRail::title { color: transparent; height: 0px; padding: 0; }
QFrame#viewportProjectionPanel, QFrame#viewportCameraPanel { background: #f5f8f6; border: 1px solid #bdc8c1; border-radius: 8px; }
QLabel#viewportNavigationReadout { background: #ffffff; border: 1px solid #bdc8c1; border-radius: 8px; color: #263c31; font-weight: 600; padding: 0 8px; }
QGroupBox#viewportControlRail QPushButton { min-height: 24px; border-radius: 0; padding: 2px 7px; }
QPushButton#viewportGridButton, QPushButton#viewportPlaneButton { border-top-left-radius: 5px; border-top-right-radius: 5px; }
QPushButton#viewportSphereButton, QPushButton#viewportFreeButton { border-bottom-left-radius: 5px; border-bottom-right-radius: 5px; }
QGroupBox#viewportControlRail QPushButton#viewportPlaneButton[turning="true"] { background: #c9e6d8; border-color: #19745d; color: #124b3a; }
QLabel#fpsIndicator, QLabel#totalFramesIndicator, QLabel#receivedPacketRateIndicator, QLabel#processedPacketsIndicator { background: #ffffff; color: #34443d; font-size: 11px; }
QPushButton#resetMetricsButton { min-height: 24px; margin-top: 3px; }
QPushButton { min-height: 28px; padding: 3px 9px; border: 1px solid #bfc8c2; background: #ffffff; }
QPushButton:hover { background: #f1f5f2; border-color: #789087; }
QPushButton:checked { background: #dfece6; border-color: #357461; color: #154b3a; }
QPushButton#onlineMode { border-top-right-radius: 0; border-bottom-right-radius: 0; }
QPushButton#offlineMode { border-top-left-radius: 0; border-bottom-left-radius: 0; border-left: 0; }
QGroupBox { font-weight: 600; border: 1px solid #d6dbd8; margin-top: 12px; padding-top: 12px; }
QGroupBox::title { subcontrol-origin: margin; left: 9px; padding: 0 4px; }
QSpinBox, QComboBox, QLineEdit { min-height: 26px; border: 1px solid #bdc6c0; background: #ffffff; padding: 1px 5px; }
QSlider::groove:horizontal { height: 4px; background: #cad1cd; }
QSlider::handle:horizontal { width: 14px; margin: -5px 0; background: #19745d; border: 1px solid #0f5946; }
